# Copy to .env on the server and fill in. Never commit .env.
# Used by both containers: cloudflared (--env-file) and api (--env-file).

# The app's address (Cloudflare Pages custom domain). Only this origin may call the API,
# which lives at the same name plus -api: here https://lifts-api.example.com.
APP_ORIGIN=https://lifts.example.com

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel: the token after --token (starts with eyJ).
TUNNEL_TOKEN=
